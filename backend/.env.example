# CELERY_BACKEND_URL are still read)
DJANGO_CELERY_BROKER_URL=
DJANGO_CELERY_RESULT_BACKEND=

# SMS gateway
DJANGO_NODE_REGISTRATION_KEY=
DJANGO_NODE_HEARTBEAT_INTERVAL_SEC=30
DJANGO_NODE_OFFLINE_AFTER_SEC=120
DJANGO_MESSAGE_ACK_TIMEOUT_SEC=60
DJANGO_MESSAGE_PENDING_TTL_SEC=3600
DJANGO_MESSAGE_MAX_DISPATCH_ATTEMPTS=5
DJANGO_MESSAGE_BULK_MAX=500

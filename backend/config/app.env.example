# Copy to config/app.env (used by app, worker and beat in docker-compose.yml)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_STATIC_ROOT=/static
DJANGO_MEDIA_ROOT=/medias

# Must match config/pg.env
DJANGO_POSTGRES_URL=postgres://postgres:change-me@pg:5432/smsgateway
# Channel layer + Celery broker. Required: the web, worker and beat processes
# only reach the node WebSockets through Redis.
DJANGO_REDIS_URL=redis://redis:6379/0

# Shared secret the Android app sends as registrationKey
DJANGO_NODE_REGISTRATION_KEY=change-me
